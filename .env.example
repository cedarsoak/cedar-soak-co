# Copy to .env.local for local development. On Vercel, add these under
# Project -> Settings -> Environment Variables. See BOOKING-SETUP.md.

# Email (contact forms, booking confirmations)
RESEND_API_KEY=
CONTACT_TO_EMAIL=cedarsoak@gmail.com

# Database (added automatically when you connect Neon Postgres in Vercel -> Storage)
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin sign-in at /admin
ADMIN_PASSWORD=
# Optional: any long random string; changing it signs everyone out
ADMIN_SESSION_SECRET=

# Public site address (used in emails and payment links)
NEXT_PUBLIC_SITE_URL=https://www.cedarsoak.co
